{
  "name": "hidenews",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/bundles.test.mjs tests/pool.test.mjs tests/icons.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "selenium-webdriver": "^4.54.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
